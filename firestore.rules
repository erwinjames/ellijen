rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{id} {
      // Public can submit one well-formed RSVP document; only signed-in admins can read/manage.
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'attending', 'guests', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.attending is bool
        && request.resource.data.guests is int
        && request.resource.data.guests >= 0 && request.resource.data.guests <= 10
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
